using NotificationLib.Models;

namespace NotificationLib.Filters;

public class SearchTextFilter : INotificationFilter
{
    public IEnumerable<Notification> Apply(
        IEnumerable<Notification> notifications,
        NotificationFilterOptions options)
    {
        if (string.IsNullOrWhiteSpace(options.SearchText))
            return notifications;

        string text = options.SearchText.Trim();
        return notifications.Where(n =>
            (n.Title?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (n.Content?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false));
    }
}

using NotificationLib.Models;

namespace NotificationLib.Filters;

public class MinPriorityFilter : INotificationFilter
{
    public IEnumerable<Notification> Apply(
        IEnumerable<Notification> notifications,
        NotificationFilterOptions options)
    {
        if (options.MinPriority is null)
            return notifications;

        int min = options.MinPriority.Value;
        return notifications.Where(n => n.Priority >= min);
    }
}


using NotificationLib.Models;

namespace NotificationLib.Sorting;

public interface INotificationSorter
{
    IEnumerable<Notification> Sort(
        IEnumerable<Notification> notifications,
        NotificationFilterOptions options);
}


using NotificationLib.Models;

namespace NotificationLib.Sorting;

public class NotificationSorter : INotificationSorter
{
    // Словарь вместо switch: новое поле сортировки добавляется одной строкой (принцип O).
    private static readonly IReadOnlyDictionary<SortNotificationBy,
        Func<IEnumerable<Notification>, bool, IEnumerable<Notification>>> Strategies =
        new Dictionary<SortNotificationBy,
            Func<IEnumerable<Notification>, bool, IEnumerable<Notification>>>
        {
            [SortNotificationBy.Date] = (items, desc) => desc
                ? items.OrderByDescending(n => n.CreatedAt)
                : items.OrderBy(n => n.CreatedAt),

            [SortNotificationBy.Priority] = (items, desc) => desc
                ? items.OrderByDescending(n => n.Priority)
                : items.OrderBy(n => n.Priority),

            [SortNotificationBy.Title] = (items, desc) => desc
                ? items.OrderByDescending(n => n.Title, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase),
        };

    public IEnumerable<Notification> Sort(
        IEnumerable<Notification> notifications,
        NotificationFilterOptions options)
    {
        // SortBy == null: порядок исходного списка сохраняется.
        if (options.SortBy is null)
            return notifications;

        if (!Strategies.TryGetValue(options.SortBy.Value, out var strategy))
            throw new ArgumentOutOfRangeException(
                nameof(options), options.SortBy, "Неизвестное поле сортировки.");

        return strategy(notifications, options.Descending);
    }
}


using NotificationLib.Filters;
using NotificationLib.Models;
using NotificationLib.Sorting;

namespace NotificationLib;

public class NotificationService
{
    private readonly IEnumerable<INotificationFilter> _filters;
    private readonly INotificationSorter _sorter;

    public NotificationService(
        IEnumerable<INotificationFilter> filters,
        INotificationSorter sorter)
    {
        _filters = filters ?? throw new ArgumentNullException(nameof(filters));
        _sorter = sorter ?? throw new ArgumentNullException(nameof(sorter));
    }

    /// <summary>Набор по умолчанию: все четыре фильтра и стандартная сортировка.</summary>
    public static NotificationService CreateDefault() => new(
        new INotificationFilter[]
        {
            new IsReadFilter(),
            new TypesFilter(),
            new SearchTextFilter(),
            new MinPriorityFilter()
        },
        new NotificationSorter());

    /// <summary>
    /// Фильтрует уведомления по заданным опциям и сортирует результат.
    /// Входная коллекция не изменяется. Вычисление отложенное.
    /// </summary>
    /// <exception cref="ArgumentNullException">notifications или options равны null.</exception>
    public IEnumerable<Notification> FilterAndSort(
        IEnumerable<Notification> notifications,
        NotificationFilterOptions options)
    {
        if (notifications is null) throw new ArgumentNullException(nameof(notifications));
        if (options is null) throw new ArgumentNullException(nameof(options));

        IEnumerable<Notification> result = notifications;

        foreach (var filter in _filters)
            result = filter.Apply(result, options);

        return _sorter.Sort(result, options);
    }
}

