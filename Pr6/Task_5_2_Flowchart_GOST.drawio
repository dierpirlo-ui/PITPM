<mxfile host="app.diagrams.net" agent="5.0" version="24.0.0">
  <diagram id="algo-main" name="1. CalculateOrderTotal">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Начало -->
        <mxCell id="start1" value="Начало" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="120" height="40" as="geometry"/>
        </mxCell>
        <!-- Ввод данных -->
        <mxCell id="data1" value="order" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Комментарий к вводу -->
        <mxCell id="comm1_line" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="data1" target="comm1_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="comm1_box" value="CalculateOrderTotal(order)&#xa;Вход: объект заказа order" style="shape=partialRectangle;whiteSpace=wrap;html=1;right=0;fillColor=none;strokeWidth=1.5;strokeColor=#000000;align=left;spacingLeft=6;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- Процесс 1: subtotal -->
        <mxCell id="proc1" value="subtotal = Σ(item.Quantity * item.UnitPrice)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Предопределенный процесс: CalculateDiscount -->
        <mxCell id="sub1" value="discount = CalculateDiscount&#xa;(order.Customer, subtotal)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.15;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Вывод результата -->
        <mxCell id="data2" value="subtotal - discount" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="500" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Конец -->
        <mxCell id="end1" value="Конец" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="120" height="40" as="geometry"/>
        </mxCell>
        <!-- Соединения (сверху вниз без стрелок по ГОСТ 19.701-90) -->
        <mxCell id="e1" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start1" target="data1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data1" target="proc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc1" target="sub1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub1" target="data2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data2" target="end1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="algo-sub" name="2. CalculateDiscount">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Начало -->
        <mxCell id="s_start" value="Начало" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="120" height="40" as="geometry"/>
        </mxCell>
        <!-- Данные -->
        <mxCell id="s_data" value="customer,&#xa;subtotal" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Комментарий -->
        <mxCell id="s_comm_l" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_data" target="s_comm_b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s_comm_b" value="Подпрограмма&#xa;CalculateDiscount" style="shape=partialRectangle;whiteSpace=wrap;html=1;right=0;fillColor=none;strokeWidth=1.5;strokeColor=#000000;align=left;spacingLeft=6;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="160" height="80" as="geometry"/>
        </mxCell>
        <!-- Решение 1 -->
        <mxCell id="s_dec1" value="customer.IsPremium&#xa;&amp;&amp; subtotal &gt; 1000" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Ветвь Да 1 -->
        <mxCell id="s_proc1" value="discount =&#xa;subtotal * 0.1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Решение 2 (ветвь Нет 1) -->
        <mxCell id="s_dec2" value="PromoCode&#xa;не пуст?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Ветвь Да 2 (Предопределенный процесс) -->
        <mxCell id="s_sub2" value="discount = ApplyPromoCode&#xa;(customer.PromoCode, subtotal)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.15;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Ветвь Нет 2 -->
        <mxCell id="s_proc0" value="discount = 0" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="510" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Вывод discount -->
        <mxCell id="s_out" value="discount" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="640" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- Конец -->
        <mxCell id="s_end" value="Конец" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="760" width="120" height="40" as="geometry"/>
        </mxCell>
        <!-- Связи -->
        <mxCell id="se1" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_start" target="s_data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se2" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_data" target="s_dec1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se3" value="Да" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="s_dec1" target="s_proc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se4" value="Нет" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;spacingLeft=4;" edge="1" parent="1" source="s_dec1" target="s_dec2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se5" value="Да" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="s_dec2" target="s_sub2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se6" value="Нет" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;spacingLeft=4;" edge="1" parent="1" source="s_dec2" target="s_proc0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se7" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_proc0" target="s_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Объединение линий со смещением (п. 4.2.3 ГОСТ 19.701-90) -->
        <mxCell id="se8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="s_proc1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="610" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="680" y="290"/>
              <mxPoint x="680" y="610"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="se9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="s_sub2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="625" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="580" y="625"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="se10" value="" style="endArrow=none;html=1;strokeWidth=1.5;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_out" target="s_end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
