using FluentAssertions;
using Moq;
using OrderProcessing.Interfaces;
using OrderProcessing.Models;
using OrderProcessing.Services;

namespace OrderProcessing.Tests
{
    public class OrderServiceTests
    {
        private readonly Mock<IOrderRepository> _ordersMock = new();
        private readonly Mock<ICustomerRepository> _customersMock = new();
        private readonly Mock<IMessageBus> _busMock = new();
        private readonly OrderService _service;

        public OrderServiceTests()
        {
            _ordersMock.Setup(o => o.AddAsync(It.IsAny<Order>())).Returns(Task.CompletedTask);
            _ordersMock.Setup(o => o.UpdateAsync(It.IsAny<Order>())).Returns(Task.CompletedTask);
            _busMock.Setup(b => b.PublishAsync(It.IsAny<string>(), It.IsAny<object>())).Returns(Task.CompletedTask);

            _service = new OrderService(_ordersMock.Object, _customersMock.Object, _busMock.Object);
        }

        private static Customer CreateCustomer() =>
            new() { Name = "Asd Zxc", Email = "asdzxc@gmail.com" };

        private static Order CreateOrder(OrderStatus status) =>
            new() { CustomerId = Guid.NewGuid(), TotalAmount = 1000m, Status = status };

        private static object? GetPayloadProperty(object payload, string name) =>
            payload.GetType().GetProperty(name)?.GetValue(payload);

        private void SetupOrderExists(Order order) =>
            _ordersMock.Setup(o => o.GetByIdAsync(order.Id)).ReturnsAsync(order);

        private void SetupOrderNotFound(Guid id) =>
            _ordersMock.Setup(o => o.GetByIdAsync(id)).ReturnsAsync((Order?)null);

        private void VerifyNothingSavedOrPublished()
        {
            _ordersMock.Verify(o => o.AddAsync(It.IsAny<Order>()), Times.Never);
            _ordersMock.Verify(o => o.UpdateAsync(It.IsAny<Order>()), Times.Never);
            _busMock.Verify(b => b.PublishAsync(It.IsAny<string>(), It.IsAny<object>()), Times.Never);
        }



        [Fact]
        public async Task CreateOrderAsync_CustomerExists_CreatesOrderAndPublishes()
        {
            var customer = CreateCustomer();
            _customersMock.Setup(c => c.GetByIdAsync(customer.Id)).ReturnsAsync(customer);

            var order = await _service.CreateOrderAsync(customer.Id, 500m);

            order.CustomerId.Should().Be(customer.Id);
            order.TotalAmount.Should().Be(500m);
            order.Status.Should().Be(OrderStatus.Pending);

            _ordersMock.Verify(o => o.AddAsync(It.Is<Order>(o => o.Id == order.Id)), Times.Once);
            _busMock.Verify(b => b.PublishAsync(
                "order.created",
                It.Is<object>(p => (Guid)GetPayloadProperty(p, "Id")! == order.Id
                                && (Guid)GetPayloadProperty(p, "CustomerId")! == customer.Id)),
                Times.Once);
        }

        [Fact]
        public async Task CreateOrderAsync_CustomerNotFound_ThrowsAndDoesNothing()
        {
            var customerId = Guid.NewGuid();
            _customersMock.Setup(c => c.GetByIdAsync(customerId)).ReturnsAsync((Customer?)null);

            Func<Task> act = () => _service.CreateOrderAsync(customerId, 100m);

            await act.Should().ThrowAsync<InvalidOperationException>().WithMessage("Клиент не найден.");
            VerifyNothingSavedOrPublished();
        }

        [Fact]
        public async Task ConfirmPaymentAsync_OrderExists_SetsPaidUpdatesAndPublishes()
        {
            var order = CreateOrder(OrderStatus.Pending);
            SetupOrderExists(order);

            await _service.ConfirmPaymentAsync(order.Id);

            order.Status.Should().Be(OrderStatus.Paid);
            _ordersMock.Verify(o => o.UpdateAsync(
                It.Is<Order>(o => o.Id == order.Id && o.Status == OrderStatus.Paid)), Times.Once);
            _busMock.Verify(b => b.PublishAsync(
                "order.paid",
                It.Is<object>(p => (Guid)GetPayloadProperty(p, "Id")! == order.Id)), Times.Once);
        }

        [Fact]
        public async Task ConfirmPaymentAsync_OrderNotFound_ThrowsAndDoesNothing()
        {
            var orderId = Guid.NewGuid();
            SetupOrderNotFound(orderId);

            Func<Task> act = () => _service.ConfirmPaymentAsync(orderId);

            await act.Should().ThrowAsync<InvalidOperationException>().WithMessage("Заказ не найден.");
            VerifyNothingSavedOrPublished();
        }

        [Fact]
        public async Task CancelOrderAsync_OrderExists_SetsCancelledUpdatesAndPublishes()
        {
            var order = CreateOrder(OrderStatus.Pending);
            SetupOrderExists(order);

            await _service.CancelOrderAsync(order.Id);

            order.Status.Should().Be(OrderStatus.Cancelled);
            _ordersMock.Verify(o => o.UpdateAsync(
                It.Is<Order>(o => o.Id == order.Id && o.Status == OrderStatus.Cancelled)), Times.Once);
            _busMock.Verify(b => b.PublishAsync(
                "order.cancelled",
                It.Is<object>(p => (Guid)GetPayloadProperty(p, "Id")! == order.Id)), Times.Once);
        }

        [Fact]
        public async Task CancelOrderAsync_OrderNotFound_ThrowsAndDoesNothing()
        {
            var orderId = Guid.NewGuid();
            SetupOrderNotFound(orderId);

            Func<Task> act = () => _service.CancelOrderAsync(orderId);

            await act.Should().ThrowAsync<InvalidOperationException>().WithMessage("Заказ не найден.");
            VerifyNothingSavedOrPublished();
        }

        [Fact]
        public async Task ShipOrderAsync_OrderIsPaid_SetsShippedUpdatesAndPublishes()
        {
            var order = CreateOrder(OrderStatus.Paid);
            SetupOrderExists(order);

            await _service.ShipOrderAsync(order.Id);

            order.Status.Should().Be(OrderStatus.Shipped);
            _ordersMock.Verify(r => r.UpdateAsync(
                It.Is<Order>(o => o.Id == order.Id && o.Status == OrderStatus.Shipped)), Times.Once);
            _busMock.Verify(b => b.PublishAsync(
                "order.shipped",
                It.Is<object>(p => (Guid)GetPayloadProperty(p, "Id")! == order.Id)), Times.Once);
        }

        [Theory]
        [InlineData(OrderStatus.Pending)]
        [InlineData(OrderStatus.Shipped)]
        [InlineData(OrderStatus.Cancelled)]
        public async Task ShipOrderAsync_OrderIsNotPaid_ThrowsAndDoesNotChangeOrder(OrderStatus status)
        {
            var order = CreateOrder(status);
            SetupOrderExists(order);

            Func<Task> act = () => _service.ShipOrderAsync(order.Id);

            await act.Should().ThrowAsync<InvalidOperationException>()
                     .WithMessage("Отправить можно только оплаченные заказы.");
            order.Status.Should().Be(status);
            VerifyNothingSavedOrPublished();
        }

        [Fact]
        public async Task ShipOrderAsync_OrderNotFound_ThrowsAndDoesNothing()
        {
            var orderId = Guid.NewGuid();
            SetupOrderNotFound(orderId);

            Func<Task> act = () => _service.ShipOrderAsync(orderId);

            await act.Should().ThrowAsync<InvalidOperationException>().WithMessage("Заказ не найден.");
            VerifyNothingSavedOrPublished();
        }
    }
}
