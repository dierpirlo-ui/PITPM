dotnet add package Selenium.WebDriver

using OpenQA.Selenium;
using OpenQA.Selenium.Chrome;
using OpenQA.Selenium.Support.UI;
using Xunit;

namespace TestApi.UiTests;

public class WebUiTests : IDisposable
{
    private const string BaseUrl = "http://localhost:5069";

    private readonly IWebDriver _driver;
    private readonly WebDriverWait _wait;

    public WebUiTests()
    {
        _driver = new ChromeDriver();
        _driver.Manage().Window.Maximize();
        _wait = new WebDriverWait(_driver, TimeSpan.FromSeconds(10));
    }

    [Fact]
    public void Login_AddAnime_AppearsInCatalog()
    {
        var title = "JoJo's Bizarre Adventure";

        _driver.Navigate().GoToUrl(BaseUrl);

        _driver.FindElement(By.Id("username")).SendKeys("dier");
        _driver.FindElement(By.Id("login-button")).Click();

        _wait.Until(d => d.FindElement(By.Id("auth-status"))
            .GetAttribute("data-authenticated") == "true");
        WaitUntilIdle();

      _driver.FindElement(By.Id("title")).SendKeys(title);
      _driver.FindElement(By.Id("genre")).SendKeys("Adventure");
      _driver.FindElement(By.Id("year")).SendKeys("2012");
      _driver.FindElement(By.Id("rating")).SendKeys("8.5");
      _driver.FindElement(By.Id("add-anime-button")).Click();

        _wait.Until(d => d.FindElement(By.Id("request-status"))
            .GetAttribute("data-code") == "201");
        WaitUntilIdle();

        _wait.Until(d => d.FindElement(By.Id("anime-list")).Text.Contains(title));

        var tableText = _driver.FindElement(By.Id("anime-list")).Text;
        Assert.Contains(title, tableText);
    }

    private void WaitUntilIdle() =>
        _wait.Until(d => d.FindElement(By.Id("api-tester"))
            .GetAttribute("aria-busy") == "false");

    public void Dispose()
    {
        _driver.Quit();
        _driver.Dispose();
    }
}
